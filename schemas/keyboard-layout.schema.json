{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/keyboard-layout.schema.json",
  "title": "Keyboard Layout",
  "description": "Versioned, script-agnostic keyboard layout consumed by the Multi-Language Keyboard Android app. Describes character key output per modifier state. Action keys (Shift/Delete/Enter/Space/Symbols/Language) are structural and are NOT represented here.",
  "type": "object",
  "required": ["schemaVersion", "languageId", "layoutId", "layoutName", "direction", "rows"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "languageId": { "type": "string", "pattern": "^[a-z0-9-]{2,16}$" },
    "layoutId": { "type": "string", "pattern": "^[a-z0-9-]{2,48}$" },
    "layoutName": { "type": "string", "minLength": 1 },
    "languageName": { "type": "string" },
    "nativeName": { "type": "string" },
    "localeTag": { "type": "string", "description": "BCP-47 tag where appropriate" },
    "script": { "type": "string", "description": "ISO 15924 script code, e.g. Latn, Arab, Deva" },
    "direction": { "type": "string", "enum": ["ltr", "rtl"] },
    "hasCase": { "type": "boolean", "description": "true only for scripts with upper/lower case" },
    "inputProcessing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["direct", "composing", "transliteration", "candidates"] },
        "combining": { "type": "boolean" },
        "composition": { "type": "boolean", "description": "true if the script requires syllable/kana/kanji composition NOT yet implemented by the app" },
        "notes": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Where the mapping came from and how far it has been verified.",
      "additionalProperties": true,
      "properties": {
        "reference": { "type": "string" },
        "verification": { "type": "string", "enum": ["unverified", "json-valid", "layout-reviewed", "branah-verified"] },
        "notes": { "type": "string" }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["rowId", "keys"],
        "additionalProperties": false,
        "properties": {
          "rowId": { "type": "string", "minLength": 1 },
          "keys": {
            "type": "array",
            "minItems": 1,
            "maxItems": 13,
            "items": {
              "type": "object",
              "required": ["keyId", "normal"],
              "additionalProperties": false,
              "properties": {
                "keyId": { "type": "string", "minLength": 1 },
                "normal": { "type": "string", "description": "Unicode output in normal state (may be empty only if label set)" },
                "shift": { "type": "string", "description": "Unicode output in Shift state; falls back to normal if absent" },
                "label": { "type": "string", "description": "Optional display label distinct from output" }
              }
            }
          }
        }
      }
    }
  }
}
